    "keywords": [
        "laravel",
        "starter-kit",
        "cms"
    ],
    "authors": [
        {
            "name": "George Ogilo",
            "email": "gogilo2003@gmail.com"
        }
    ],
    "scripts": {
        "setup": [
            "composer install --working-dir=laravel",
            "@php laravel/artisan key:generate",
            "npm --prefix laravel install"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently \"php laravel/artisan serve\" \"npm --prefix laravel run dev\""
        ]
    }
}