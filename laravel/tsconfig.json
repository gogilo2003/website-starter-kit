{
    "compilerOptions": {
        "allowJs": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "preserve",
        "strict": true,
        "isolatedModules": true,
        "target": "ESNext",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "skipLibCheck": true,
        "paths": {
            "@/*": [
                "./resources/js/*",
                "./packages/meacms/menu/resources/js/*"
            ],
            "@meacms/menu/*": [
                "./packages/meacms/menu/resources/js/*"
            ],
            "@meacms/products/*": [
                "./packages/meacms/products/resources/js/*"
            ],
            "@meacms/quotes/*": [
                "./packages/meacms/quotes/resources/js/*"
            ],
            "@meacms/news/*": [
                "./packages/meacms/news/resources/js/*"
            ],
            "@meacms/downloads/*": [
                "./packages/meacms/downloads/resources/js/*"
            ],
            "@meacms/partners/*": [
                "./packages/meacms/partners/resources/js/*"
            ],
            "@meacms/slides/*": [
                "./packages/meacms/slides/resources/js/*"
            ],
            "@meacms/page-sections/*": [
                "./packages/meacms/page-sections/resources/js/*"
            ],
            "ziggy-js": [
                "./vendor/tightenco/ziggy"
            ]
        },
        "typeRoots": [
            "./node_modules/@types",
            "./resources/js/types"
        ]
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.vue",
        "packages/meacms/*/resources/js/**/*.ts",
        "packages/meacms/*/resources/js/**/*.vue"
    ]
}