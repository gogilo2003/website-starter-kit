{
    "name": "gogilo/partners",
    "description": "Partners content-type package for Laravel starter kit.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "gogilo/menu": "*",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Gogilo\\Partners\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gogilo\\Partners\\PartnersServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
