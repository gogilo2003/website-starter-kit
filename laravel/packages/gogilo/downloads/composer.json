{
    "name": "gogilo/downloads",
    "description": "A comprehensive Laravel package for managing file downloads with secure signed URLs, S3 support, and frontend integration",
    "type": "library",
    "keywords": ["laravel", "downloads", "files", "s3", "secure"],
    "license": "MIT",
    "authors": [
        {
            "name": "Gogilo Team",
            "email": "team@gogilo.com"
        }
    ],
    "require": {
        "php": "^8.0|^8.1|^8.2|^8.3|^8.4",
        "gogilo/menu": "*",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Gogilo\\Downloads\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gogilo\\Downloads\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gogilo\\Downloads\\DownloadsServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}