{
    "name": "gogilo/products",
    "description": "Products content-type package for Laravel starter kit.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Gogilo\\Products\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gogilo\\Products\\ProductsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
