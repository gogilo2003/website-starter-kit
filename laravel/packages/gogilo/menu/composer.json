{
    "name": "gogilo/menu",
    "description": "Centralized menu registry for the Laravel starter kit. Packages register admin and public menu items; the host exposes them as the single source of truth.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Gogilo Team",
            "email": "team@gogilo.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Gogilo\\Menu\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gogilo\\Menu\\MenuServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
